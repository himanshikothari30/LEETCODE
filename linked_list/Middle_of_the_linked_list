class Solution {
public:
    ListNode* middleNode(ListNode* head) {
        int i;
        int n=0;
        Listnode* temp=head;
        while(temp!=NULL){
            n++;
            temp=temp->next;
        }
        temp=head;
        for(i=0;i<n/2;i++){
            temp=temp->next;

        }
        return temp;

        
    }
};
